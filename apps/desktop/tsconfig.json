{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Node16",
    "moduleResolution": "Node16",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "rootDir": "../..",
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "@music/core": ["./../../packages/core/src/index.ts"]
    }
  },
  "include": ["src", "electron"]
}
